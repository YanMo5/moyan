{
  "version": 2,
  "functions": {
    "api/[...route].js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/?.*",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
