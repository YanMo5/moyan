# ─────────────────────────────────────────────────────────────
# 站点环境变量示例（复制为 .env 后填写真实值；.env 已被 .gitignore 忽略）
# 本地：node server/server.js 会自动读取项目根目录的 .env
# 线上：在 Vercel 项目 → Settings → Environment Variables 里逐条添加
# ─────────────────────────────────────────────────────────────

# “联系我”留言的邮件通知（QQ 邮箱示例）
# 授权码获取：QQ 邮箱 → 设置 → 账号 → 开启 POP3/SMTP 服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-authorization-code
# 收件邮箱，留空则默认发给 SMTP_USER
CONTACT_TO=your-recipient@example.com
# 可选：发件人显示名
# SMTP_FROM=YanMo Blog <your-email@example.com>

# 可选：超时（毫秒），默认 连接8000 / 握手6000 / 读12000 / 硬上限9000
# SMTP_CONNECTION_TIMEOUT=8000
# SMTP_GREETING_TIMEOUT=6000
# SMTP_SOCKET_TIMEOUT=12000
# SMTP_HARD_TIMEOUT=9000

# 可选：站点公开地址（用于 sitemap / RSS 的绝对链接；不填则按请求 Host 推断）
# SITE_URL=https://your-domain.com

# 可选：服务端口 / 数据库路径（server/server.js）
# PORT=3000
# DB_PATH=./data/blog.db

# 可选：管理员登录安全（server/server.js；云端同名变量见 README）
# 仅在可信反向代理后部署时开启，否则不要信任 X-Forwarded-For
# TRUST_PROXY=1
# 通过 HTTPS 访问本地服务时启用 Secure Cookie
# SESSION_COOKIE_SECURE=1
# SESSION_TTL_MS=86400000
# SESSION_IDLE_TTL_MS=43200000
# PASSWORD_HASH_ITERATIONS=600000
# LOGIN_WINDOW_MS=600000
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MS=900000
# 管理员会话持久化文件（默认 data/admin-sessions.json，含会话 ID 与 CSRF；Linux 下建议 chmod 600）
# ADMIN_SESSIONS_FILE=./data/admin-sessions.json

# 云端（Vercel）专用变量；本地 Node 不需要
# ADMIN_USERNAME=your-admin-name
# ADMIN_PASSWORD=your-strong-password
# ADMIN_SESSION_SECRET=long-random-string
# DATABASE_URL=postgres://user:pass@host:5432/db
